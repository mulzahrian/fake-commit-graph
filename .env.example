GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified email on your GitHub account, otherwise commits won't show on the graph
GITHUB_EMAIL=you@example.com
REPO_NAME=contribution-graph
PRIVATE_REPO=false

# Used by name_graph.js: draws GRAPH_NAME on the GRAPH_YEAR contribution graph
GRAPH_YEAR=2014
# Max 8 characters, only A-Z, 0-9 and space
GRAPH_NAME=HELLO
# Optional (default: 2)
# GRAPH_COMMITS_PER_PIXEL=2
